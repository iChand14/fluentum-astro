{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "baseUrl": ".",
    "types": ["node"],
    "paths": {
      "@layouts/*": ["src/layouts/*"],
      "@shared/*": ["src/shared/*"],
      "@components/*": ["src/components/*"],
      "@containers/*": ["src/containers/*"]
    }
  }
}
