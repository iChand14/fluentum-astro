---
import FeaturesSection from "@components/FeaturesSection.astro"

const logos = [
    { name: 'Paytren', src: "/Paytren.png" },
    { name: 'Visa', src: "/VISA.png" },
    { name: 'E-Money', src: "/E-Money.png" },
];

const features = [
    {
        title: "Real-time Data",
        description: "Access and analyze data in real-time for faster decision-making and improved performance.",
    },
    {
        title: "Scalability",
        description: "Easily scale your operations with our flexible and robust platform designed to grow with your business.",
    },
    {
        title: "Enterprise Reliability",
        description: "Built with enterprise-grade reliability, ensuring your data is secure and always available when you need it.",
    },
]

interface Tab {
  id: string;
  label: string;
  title: string;
  description: string;
  image: string;
}

const tabs: Tab[] = [
  {
    id: 'decision',
    label: 'Decision',
    title: 'Make decisions with live data',
    description: 'Stream events and metrics in real time to power dashboards, BI tools, and operational monitoring with sub-second latency. Stream events and metrics in real time to power dashboards, BI tools, and operational monitoring with sub-second latency.',
    image: './Decision.jpg'
  },
  {
    id: 'driven-apps',
    label: 'Driven Apps',
    title: 'Build event-driven applications',
    description: 'Create responsive applications that react to events instantly. Enable real-time features like live updates, notifications, and collaborative editing with minimal latency.',
    image: './DrivenApps.jpg'
  },
  {
    id: 'detect-threats',
    label: 'Detect Threats',
    title: 'Real-time threat detection',
    description: 'Monitor security events as they happen. Identify anomalies and potential threats instantly with continuous stream processing and automated alerting.',
    image: './DetectThreats.jpg'
  },
  {
    id: 'feed-models',
    label: 'Feed Models',
    title: 'Power ML models with live data',
    description: 'Continuously feed fresh data to your machine learning models. Enable real-time predictions and keep your AI systems up to date with streaming data pipelines.',
    image: './FeedModels.jpg'
  }
];
---
<div class="bg-gradient-to-b from-slate-950 via-slate-900 to-sky-900/75">
    <section class="h-[100dvh] pt-20 bg-[url('/Pattern.png')] bg-bottom bg-contain bg-no-repeat">

    <div class="relative w-full z-10 flex items-center justify-center h-full">
        <div class="container mx-auto px-4 sm:px-8 md:px-16 lg:px-24 xl:px-32 2xl:px-40">
            <div class="flex text-center justify-center mb-40">
                <img src="/hero-image.png" alt="Hero Image" class="transform scale-125 transition-transform duration-300">
            </div>
            <div class="grid grid-cols-3 gap-4">
                <div class="col-span-2">
                    <span class="text-cyan-400">Real-Time Data Platform</span>
                    <div class="text-white text-5xl font-bold my-4 text-balance">
                        Power <span class="bg-clip-text text-transparent bg-gradient-to-r from-sky-600 to-sky-900">Real-Time Data</span> for Analytics 
                        and Event-driven Apps
                    </div>
                    <p class="text-lg text-gray-400 text-pretty">
                        Delivering reliable event-driven integration with full visibility, control, and scalability
                        for modern enterprice and erchitectures.
                    </p>
                </div>
                <div class="col-span-1 content-end space-x-4">
                    <button class="px-6 py-4 text-nowrap font-semibold bg-gradient-to-r from-blue-500 to-blue-900 rounded-lg">Request Demo</button>
                    <button class="px-6 py-4 text-nowrap font-semibold bg-transparent border border-blue-500 rounded-lg">Explore Platforms</button>
                </div>
            </div>
            
        </div>
    </div>

  </section>
</div>
<div class="bg-gradient-to-t from-slate-950 via-slate-900 to-sky-900/75">
    <FeaturesSection>
        <div class="text-center">
            <section class="overflow-hidden mb-16">
                <span class="text-xl block text-center">Organizations rely on Fluentum to power mission-critical workloads.</span>
                <div class="max-w-3xl px-3 mx-auto overflow-hidden mt-8">
                    <div class="flex animate-marquee gap-8">
                        {Array(10).fill(logos).flat().map((logo, i) => (
                            <img
                                src={logo.src} 
                                alt={logo.name}
                                class="h-10 w-auto flex-shrink-0"
                            />
                        ))}
                    </div>
                </div>
            </section>
            <span class="text-sm text-cyan-400 font-medium">Why Fluentum</span>
            <div class="text-white text-5xl font-bold my-5 text-balance">
                Why team Choose <span class="bg-clip-text text-transparent bg-gradient-to-r from-sky-600 to-sky-900">Fluentum</span>
            </div>
            <span class="text-base text-white font-normal">A unified platform built for real-time data, scale, and enterprise reliability.</span>
            <!-- Container dengan background pattern yang overflow -->
            <div class="relative flex flex-wrap justify-center gap-8 mt-10 overflow-hidden">
                {features.map((feature, index) => (
                    <div class="w-[350px] h-[400px] py-6 px-4 bg-gradient-to-b from-blue-500 to-blue-950 rounded-xl relative text-left">
                        <div class="text-white font-medium text-xl">{feature.title}</div>
                        <span class="text-white font-normal text-sm">{feature.description}</span>
                    </div>
                    <div class="absolute w-full h-[405px] bottom-0 left-0 right-0 mb-60 bg-[url('/Pattern-2.png')] bg-center bg-no-repeat translate-y-full"></div>
                ))}
            </div>
        </div>
    </FeaturesSection>
</div>
<div class="bg-slate-950">
    <FeaturesSection>
        <div class="text-center max-w-5xl mx-auto mb-14">
            <span class="text-sm text-cyan-400 font-medium">Platform</span>
            <div class="text-white text-5xl font-bold my-5 text-pretty">
                Core Features Built for <span class="bg-clip-text text-transparent bg-gradient-to-r from-cyan-400 to-blue-500">Reliable</span>, <span class="bg-clip-text text-transparent bg-gradient-to-r from-cyan-400 to-blue-500">Scalable</span> 
                Production Workloads.
            </div>
            <span class="text-base text-white font-normal">A unified platform built for real-time data, scale, and enterprise reliability.</span>
        </div>
        <div class="grid grid-cols-3 grid-rows-2 gap-6">
            <div class="col-span-2 row-span-1 text-start bg-transparent border border-blue-500 rounded-2xl px-6 py-4">
                <h5 class="text-xl font-medium mb-3">Kafka-compatible APIs</h5>
                <span class="text-sm">Run existing workloads without rewriting applications</span>
            </div>
            <div class="col-span-1 row-span-2 text-start bg-transparent border border-blue-500 rounded-2xl px-6 py-4">
                <h5 class="text-xl font-medium mb-3">Built-in Connectors</h5>
                <span class="text-sm">Integrate with databases, cloud services, and analytics tools</span>
            </div>
            <div class="col-span-1 row-span-1 h-72 text-start bg-transparent border border-blue-500 rounded-2xl px-6 py-4">
                <h5 class="text-xl font-medium mb-3">Observability & Monitoring</h5>
                <span class="text-sm">Gain visibility into pipelines and system performance</span>
            </div>
            <div class="col-span-1 row-span-1 text-start bg-transparent border border-blue-500 rounded-2xl px-6 py-4">
                <h5 class="text-xl font-medium mb-3">Security & Access Control</h5>
                <span class="text-sm">Enterprise-grade authentication and role-based access</span>
            </div>
        </div>
    </FeaturesSection>
</div>
<div class="bg-gradient-to-b from-slate-950 to-cyan-900 overflow-x-hidden">
    <FeaturesSection>
        <div class="text-start max-w-5xl mb-14">
            <span class="text-sm text-cyan-400 font-medium">Use Case</span>
            <div class="text-white text-5xl font-bold my-5 text-pretty">
                Core Features Built for 
                <span class="bg-clip-text text-transparent bg-gradient-to-r from-blue-500 to-blue-900 block">Real-time Data</span>
            </div>
        </div>
        <div class="relative w-full">
            <div class="absolute -right-96 top-0 -translate-y-1/2 w-[1134px] h-[524px] bg-[url('./Pattern-3.png')] bg-no-repeat bg-contain bg-center  pointer-events-none"></div>
            <div class="w-full max-w-6xl mx-auto px-4" data-tabs-container>
                <!-- Tab Navigation -->
                <div class="flex flex-row justify-around items-center text-center gap-4 mb-14 border-b border-slate-700/50">
                    {tabs.map((tab, index) => (
                    <button type="button" class:list={[
                        "w-full py-4 text-xl transition-all duration-300 relative group",
                        "text-slate-400 hover:text-sky-300",
                        "data-[active=true]:text-cyan-300 data-[active=true]:font-medium"
                        ]} data-tab={tab.id} data-index={index} data-active={index === 0 ? "true" : "false"} aria-selected={index === 0 ? "true" : "false"} role="tab">
                            {tab.label}
                        <span class="absolute bottom-0 left-0 w-full h-0.5 bg-cyan-400 transform scale-x-0 transition-transform duration-300 group-data-[active=true]:scale-x-100 shadow-[0_0_10px_rgba(34,211,238,0.5)]" />
                    </button>
                    ))}
                </div>

                <!-- Tab Panels Container dengan overflow hidden untuk slide animation -->
                <div class="relative overflow-hidden min-h-[400px]">
                    {tabs.map((tab, index) => (
                    <div class:list={[
                        "flex flex-col lg:flex-row gap-8 justify-between transition-all duration-500 ease-out absolute w-full",
                        "data-[active=true]:relative data-[active=true]:translate-x-0 data-[active=true]:opacity-100",
                        "data-[direction=right]:translate-x-full data-[direction=left]:-translate-x-full",
                        "data-[active=false]:opacity-0"
                        ]} data-panel={tab.id} data-index={index} data-active={index === 0 ? "true" : "false"} data-direction="none" role="tabpanel">
                        <div class="lg:w-1/2">
                            <img class="rounded-xl aspect-[16/9] h-80 w-full object-cover shadow-[inset_0_0_20px_rgba(0,0,0,0.3)] ring-1 ring-slate-700/50" src={tab.image} alt={`${tab.label} Image`} loading={index === 0 ? "eager" : "lazy"} />
                        </div>
                        <div class="flex flex-col gap-6 py-8 lg:w-1/2 lg:pl-8">
                            <h2 class="font-bold text-sky-500 text-3xl leading-tight">
                                {tab.title}
                            </h2>
                            <p class="text-slate-300 text-lg leading-relaxed">
                                {tab.description}
                            </p>
                        </div>
                    </div>
                    ))}
                </div>
                </div>
        </div>
    </FeaturesSection>
</div>

<style>
    @keyframes marquee {
        0% { transform: translateX(0); }
        100% { transform: translateX(-50%); }
    }
    
    .animate-marquee {
        animation: marquee 30s linear infinite;
    }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const container = document.querySelector('[data-tabs-container]');
    if (!container) return;

    const tabButtons = container.querySelectorAll('[data-tab]');
    const tabPanels = container.querySelectorAll('[data-panel]');
    let currentIndex = 0;

    function switchTab(targetId: string) {
      const targetButton = container?.querySelector(`[data-tab="${targetId}"]`);
      const targetIndex = parseInt(targetButton?.getAttribute('data-index') || '0');
      
      // Tentukan arah animasi
      const direction = targetIndex > currentIndex ? 'right' : 'left';
      currentIndex = targetIndex;

      // Update buttons
      tabButtons.forEach(button => {
        const isActive = button.getAttribute('data-tab') === targetId;
        button.setAttribute('data-active', isActive ? 'true' : 'false');
        button.setAttribute('aria-selected', isActive ? 'true' : 'false');
      });

      // Update panels dengan slide animation
      tabPanels.forEach(panel => {
        const isActive = panel.getAttribute('data-panel') === targetId;

        if (isActive) {
          // Panel yang akan aktif: geser dari arah yang sesuai
          panel.setAttribute('data-direction', direction === 'right' ? 'right' : 'left');
          panel.setAttribute('data-active', 'false');
          
          // Force reflow menggunakan getBoundingClientRect (type-safe)
          void panel.getBoundingClientRect();
          
          // Aktifkan panel
          panel.setAttribute('data-active', 'true');
          panel.setAttribute('data-direction', 'none');
        } else {
          // Panel yang tidak aktif: geser keluar ke arah berlawanan
          const isCurrentActive = panel.getAttribute('data-active') === 'true';
          if (isCurrentActive) {
            panel.setAttribute('data-direction', direction === 'right' ? 'left' : 'right');
            panel.setAttribute('data-active', 'false');
          }
        }
      });
    }

    // Add click handlers
    tabButtons.forEach(button => {
      button.addEventListener('click', () => {
        const tabId = button.getAttribute('data-tab');
        if (tabId) switchTab(tabId);
      });
    });
  });
</script>