---
const { title, description } = Astro.props;
---
<div class="w-[350px] h-[400px] py-6 px-4 bg-gradient-to-b from-blue-500 to-blue-950 rounded-xl relative text-left">
    <div class="text-white font-medium text-xl">{title}</div>
    <span class="text-white font-normal text-sm">{description}</span>
</div>