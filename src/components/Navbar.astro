---
// src/components/Navbar.astro

const currentPath = Astro.url.pathname;

const navLinks = [
  { href: "/product", label: "Product" },
  { href: "/solutions", label: "Solutions" },
  { href: "/pricing", label: "Pricing" },
  { href: "/support", label: "Support" },
  { href: "/company", label: "Company" },
  { href: "/blog", label: "Blog" },
  { href: "/documentation", label: "Documentation" },
];

function isActive(href: string): boolean {
  // Exact match for home, startsWith for others
  if (href === "/") return currentPath === "/";
  return currentPath.startsWith(href);
}
---

<nav class="fixed top-0 left-0 w-full z-50 bg-transparent">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex items-center justify-between">
    
    <!-- Brand -->
    <div class="flex items-center" data-logo>
      <a href="/"><img src="/icon-fluentum.png" alt="Fluentum Logo" class="h-8 w-auto"></a>
    </div>

    <!-- Desktop Menu -->
    <div class="hidden lg:flex items-center gap-8">
      <div class="flex gap-6 text-white text-sm">
        {navLinks.map((link) => (
          <a 
            href={link.href} 
            class:list={[
              "transition-all duration-200",
              isActive(link.href) 
                ? "font-semibold" 
                : "hover:text-gray-400 font-light"
            ]}
          >
            {link.label}
          </a>
        ))}
      </div>
    </div>

    <!-- Desktop CTA -->
    <div class="hidden lg:flex items-center gap-4">
      <a href="/login" class="px-4 py-2 text-white font-medium hover:text-white/50">
        Login
      </a>
      <a 
        href="/demo" 
        class:list={[
          "px-5 py-2.5 font-medium border rounded-lg transition-all duration-300",
          isActive("/demo")
            ? "bg-cyan-500/20 border-cyan-400 text-cyan-400 shadow-[0_0_20px_rgba(34,211,238,0.4)]"
            : "text-white border-blue-500/50 hover:bg-cyan-500/10 hover:border-blue-400 shadow-[0_0_15px_rgba(34,211,238,0.15)] hover:shadow-[0_0_20px_rgba(34,211,238,0.3)]"
        ]}
      >
        Request Demo
      </a>
    </div>

    <!-- Mobile Menu Button -->
    <button 
      type="button"
      class="lg:hidden p-2 text-white hover:text-white/75"
      aria-label="Toggle menu"
      aria-expanded="false"
      data-menu-toggle
    >
      <svg data-icon="open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
      <svg data-icon="close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>

  </div>

  <!-- Mobile Menu Overlay -->
  <div 
    class="lg:hidden fixed inset-0 pt-[72px] bg-slate-900/95 backdrop-blur-sm transform translate-x-full transition-transform duration-300 ease-in-out"
    data-mobile-menu
  >
    <div class="flex flex-col p-6 gap-6">
      <!-- Mobile Links -->
      <div class="flex flex-col gap-4 text-white text-lg">
        {navLinks.map((link, index) => (
          <a 
            href={link.href} 
            class:list={[
              "py-2 transition-all",
              // Border-b hanya jika BUKAN item terakhir
              index !== navLinks.length - 1 && "border-b border-slate-700/50",
              isActive(link.href)
                ? "bg-clip-text text-transparent bg-gradient-to-r from-blue-600 from-20% via-blue-400 via-40% to-slate-800 font-semibold"
                : "hover:text-gray-400"
            ]}
          >
            {link.label}
          </a>
        ))}
      </div>

      <!-- Mobile CTA -->
      <div class="flex flex-col gap-3 mt-4">
        <a 
          href="/login" 
          class:list={[
            "w-full text-center px-4 py-3 font-medium border rounded-lg transition-all",
            isActive("/login")
              ? "border-cyan-400 text-cyan-400 bg-cyan-500/10"
              : "border-slate-600 hover:border-blue-500"
          ]}
        >
          Login
        </a>
        <a 
          href="/demo" 
          class:list={[
            "w-full text-center px-4 py-3 font-medium rounded-lg transition-all",
            isActive("/demo")
              ? "bg-cyan-500 text-slate-900 font-bold"
              : "bg-gradient-to-r from-blue-500 to-blue-900 hover:from-blue-600 hover:to-blue-950 text-white"
          ]}
        >
          Request Demo
        </a>
      </div>
    </div>
  </div>

</nav>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toggle = document.querySelector('[data-menu-toggle]');
    const menu = document.querySelector('[data-mobile-menu]');
    const iconOpen = toggle?.querySelector('[data-icon="open"]');
    const iconClose = toggle?.querySelector('[data-icon="close"]');
    const logo = document.querySelector('[data-logo]');
    
    let isOpen = false;

    function toggleMenu() {
      isOpen = !isOpen;
      logo?.classList.toggle('z-50', isOpen);
      toggle?.classList.toggle('z-50', isOpen);
      menu?.classList.toggle('translate-x-full', !isOpen);
      menu?.classList.toggle('translate-x-0', isOpen);
      iconOpen?.classList.toggle('hidden', isOpen);
      iconClose?.classList.toggle('hidden', !isOpen);
      toggle?.setAttribute('aria-expanded', isOpen.toString());
      document.body.style.overflow = isOpen ? 'hidden' : '';
    }

    toggle?.addEventListener('click', toggleMenu);
    menu?.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => { if (isOpen) toggleMenu(); });
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) toggleMenu();
    });
  });
</script>