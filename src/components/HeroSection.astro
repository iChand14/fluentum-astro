---
// src/components/HeroSection.astro

import Button from './ui/Button.astro';

interface Props {
  img?: string;
  eyebrow?: string;
  title: string;
  description: string;
  primaryButton?: {
    text: string;
    href: string;
  };
  secondaryButton?: {
    text: string;
    href: string;
  };
}

const { 
  img, 
  eyebrow = "Real-Time Data Platform",
  title, 
  description,
  primaryButton = { text: "Request Demo", href: "#demo" },
  secondaryButton = { text: "Explore Platform", href: "#platform" }
} = Astro.props;
---

<section class:list={[
  "min-h-[100dvh] py-20 lg:pt-24 xl:pt-40 bg-[url('/Pattern.png')] bg-bottom bg-contain bg-no-repeat flex items-center",
  !img && "justify-center"  // Center vertically when no image
]}>
    
    <div class="relative w-full z-10">
        <div class="container mx-auto px-4 sm:px-6 md:px-8 lg:px-12 xl:px-16 2xl:px-20">
        
            <!-- CONDITIONAL: Jika ada image, tampilkan seperti Gambar 2 -->
            {img && (
                <div class="flex text-center justify-center mb-20 lg:mb-40">
                    <img 
                        src={img} 
                        alt="Hero Image" 
                        class="w-full max-w-lg sm:max-w-xl lg:max-w-2xl xl:max-w-3xl transform scale-100 lg:scale-110 transition-transform duration-300" 
                    />
                </div>
            )}

            <!-- Grid Layout - menyesuaikan berdasarkan ada/tidaknya image -->
            <div class:list={[
                "grid grid-cols-1 gap-8",
                img ? "lg:grid-cols-3 items-end" : "lg:grid-cols-1 items-center text-center"
            ]}>
                
                <!-- Content Container -->
                <div class:list={[
                    "flex flex-col",
                    img ? "lg:col-span-2 text-center lg:text-start" : "col-span-1 items-center text-center mx-auto max-w-4xl"
                ]}>
                    <span class="text-cyan-400 text-sm lg:text-base font-medium tracking-wide uppercase">
                        {eyebrow}
                    </span>
                    
                    <h1 class:list={[
                        "text-white text-3xl sm:text-4xl lg:text-5xl xl:text-6xl font-bold my-4 lg:my-6 leading-tight",
                        !img && "max-w-4xl"
                    ]}>
                        <Fragment set:html={title} />
                    </h1>
                    
                    <p class:list={[
                        "text-base lg:text-lg text-gray-400 leading-relaxed",
                        img ? "max-w-2xl mx-auto lg:mx-0" : "max-w-2xl mx-auto"
                    ]}>
                        {description}
                    </p>
                    
                    <!-- Buttons - Pindah ke dalam container content ketika tidak ada image -->
                    {!img && (
                        <div class="flex flex-row gap-3 mt-8 justify-center">
                            <Button 
                                href={primaryButton.href}
                                gradient={{ from: 'blue-500', to: 'blue-900' }}
                                rounded="lg"
                                size="md"
                            >
                                {primaryButton.text}
                            </Button>
                            
                            <Button 
                                href={secondaryButton.href}
                                outlineColor={{ color: 'blue', value: '500', textValue: '100', hoverBg: true }}
                                rounded="lg"
                                size="md"
                            >
                                {secondaryButton.text}
                            </Button>
                        </div>
                    )}
                </div>

                <!-- Buttons - Hanya muncul di kanan bawah ketika ADA image -->
                {img && (
                    <div class="col-span-1 content-end w-full">
                        <div class="flex flex-row gap-3 justify-center lg:justify-start mt-6">
                            <Button 
                                href={primaryButton.href}
                                gradient={{ from: 'blue-500', to: 'blue-900' }}
                                rounded="lg"
                                size="md"
                            >
                                {primaryButton.text}
                            </Button>
                            
                            <Button 
                                href={secondaryButton.href}
                                outlineColor={{ color: 'blue', value: '500', textValue: '100', hoverBg: true }}
                                rounded="lg"
                                size="md"
                            >
                                {secondaryButton.text}
                                <span>↓</span>
                            </Button>
                        </div>
                    </div>
                )}

            </div>
        
        </div>
    </div>

</section>