---
import FeaturesSection from "./FeaturesSection.astro"
---
<div class="bg-gradient-to-b from-cyan-900 to-slate-950">
    <FeaturesSection>
        <div class="flex flex-col lg:flex-row gap-4 lg:gap-0 justify-between w-full h-auto lg:h-[499px] bg-slate-900 rounded-2xl p-10 bg-[url('./Vector.png')] bg-no-repeat bg-center border border-blue-500 mb-20">
            <div class="flex flex-col gap-4 w-full xl:w-1/4 justify-between">
                <div class="flex flex-col gap-4 justify-between">
                    <img src="./icon-fluentum.png" alt="Fluentum Icon" class="w-[176px] h-auto">
                    <div class="flex flex-row gap-4 justify-between w-3/4">
                        <div class="flex flex-col gap-4">
                            <a href="#" class="text-lg bg-clip-text text-transparent underline bg-gradient-to-r from-blue-600 from-20% via-blue-400 via-40% to-slate-800">Home</a>
                            <a href="#" class="text-lg bg-clip-text text-transparent underline bg-gradient-to-r from-blue-600 from-20% via-blue-400 via-40% to-slate-800">Product</a>
                            <a href="#" class="text-lg bg-clip-text text-transparent underline bg-gradient-to-r from-blue-600 from-20% via-blue-400 via-40% to-slate-800">Resources</a>
                        </div>
                        <div class="flex flex-col gap-4">
                            <a href="#" class="text-lg bg-clip-text text-transparent underline bg-gradient-to-r from-blue-600 from-20% via-blue-400 via-40% to-slate-800">Solutions</a>
                            <a href="#" class="text-lg bg-clip-text text-transparent underline bg-gradient-to-r from-blue-600 from-20% via-blue-400 via-40% to-slate-800">Pricing</a>
                            <a href="#" class="text-lg bg-clip-text text-transparent underline bg-gradient-to-r from-blue-600 from-20% via-blue-400 via-40% to-slate-800">Company</a>
                        </div>
                    </div>
                </div>
                <div class="hidden lg:flex flex-col gap-4">
                    <h5 class="text-white text-lg font-medium">Follow US</h5>
                    <div class="flex gap-4">
                        <a href="#" class="w-12 h-12 rounded-full border-2 border-blue-400 flex items-center justify-center text-white hover:bg-blue-400 hover:text-blue-900 transition-all">
                            <img src="./Facebook.png" alt="Facebook Icon">
                        </a>
                        <a href="#" class="w-12 h-12 rounded-full border-2 border-blue-400 flex items-center justify-center text-white hover:bg-blue-400 hover:text-blue-900 transition-all">
                            <img src="./Google.png" alt="Google Icon">
                        </a>
                        <a href="#" class="w-12 h-12 rounded-full border-2 border-blue-400 flex items-center justify-center text-white hover:bg-blue-400 hover:text-blue-900 transition-all">
                            <img src="./Instagram.png" alt="Instagram Icon">
                        </a>
                        <a href="#" class="w-12 h-12 rounded-full border-2 border-blue-400 flex items-center justify-center text-white hover:bg-blue-400 hover:text-blue-900 transition-all">
                            <img src="./YouTube.png" alt="YouTube Icon">
                        </a>
                    </div>
                </div>
            </div>
            <div class="flex flex-col gap-4 w-full xl:w-1/4 justify-between">
                <div class="flex flex-col gap-2">
                    <h5 class="text-sm font-medium leading-4">Contact Us</h5>
                    <p class="text-lg text-gray-400">(022) 7272408</p>
                </div>
                <div class="flex flex-col gap-2">
                    <h5 class="text-sm font-medium leading-4">Location</h5>
                    <p class="text-lg text-gray-400">Jl. RE Martadinata No.223-227, Bandung, Jawa Barat, Indonesia</p>
                </div>
                <div class="flex flex-col gap-2">
                    <h5 class="text-sm font-medium leading-4">Email</h5>
                    <p class="text-lg text-gray-400">hello@fluentum.com</p>
                </div>
                <div class="flex lg:hidden flex-col gap-4">
                    <h5 class="text-white text-lg font-medium">Follow US</h5>
                    <div class="flex gap-4">
                        <a href="#" class="w-12 h-12 rounded-full border-2 border-blue-400 flex items-center justify-center text-white hover:bg-blue-400 hover:text-blue-900 transition-all">
                            <img src="./Facebook.png" alt="Facebook Icon">
                        </a>
                        <a href="#" class="w-12 h-12 rounded-full border-2 border-blue-400 flex items-center justify-center text-white hover:bg-blue-400 hover:text-blue-900 transition-all">
                            <img src="./Google.png" alt="Google Icon">
                        </a>
                        <a href="#" class="w-12 h-12 rounded-full border-2 border-blue-400 flex items-center justify-center text-white hover:bg-blue-400 hover:text-blue-900 transition-all">
                            <img src="./Instagram.png" alt="Instagram Icon">
                        </a>
                        <a href="#" class="w-12 h-12 rounded-full border-2 border-blue-400 flex items-center justify-center text-white hover:bg-blue-400 hover:text-blue-900 transition-all">
                            <img src="./YouTube.png" alt="YouTube Icon">
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="flex flex-col xl:flex-row justify-center xl:justify-between items-center xl:items-end gap-8 xl:gap-4">
            <h1 class="text-4xl w-full xl:w-1/2 font-medium text-center xl:text-left">
                Get the latest product updates, insights, and offers tailored to your real-time data needs
            </h1>
            <div class="xl:w-1/2 px-8 xl:px-2">
                <span class="text-center xl:text-start text-white text-lg font-medium block mb-4">
                    Leave your email and we'll share product updates, insights, and offers.
                </span>
  
                <form class="relative group" onsubmit="event.preventDefault();">
                    <input type="email" name="email" id="email-input" placeholder="YOUR EMAIL" class="w-full py-5 px-6 pr-14 bg-slate-900/50 border border-slate-400/30 rounded-2xl  text-white placeholder-slate-400/70 text-sm tracking-wider uppercase focus:outline-none focus:border-slate-300/50 focus:ring-1 focus:ring-slate-300/30 transition-all duration-300" required />
                    
                    <button type="submit" class="absolute right-4 top-1/2 -translate-y-1/2 p-2 text-white/80 hover:translate-x-1 transition-all duration-300" aria-label="Subscribe">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                        </svg>
                    </button>
                </form>
            </div>
        </div>
    </FeaturesSection>
</div>