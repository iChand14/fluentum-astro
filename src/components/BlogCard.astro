---
interface Props {
  title: string;
  excerpt: string;
  image: string;
  category: string;
  date: string;
  href?: string;
  variant?: 'featured' | 'grid' | 'compact' | 'category-list';
}

const {
  title,
  excerpt,
  image,
  category,
  date,
  href = '#',
  variant = 'grid'
} = Astro.props;

// Format date
const formatDate = (dateString: string) => {
  const date = new Date(dateString);
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric'
  });
};
---

{variant === 'featured' && (
//   <!-- Mode 3: Featured (1 data terbaru) - Gambar 1 -->
    <article class="group">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
            <div class="hidden lg:block lg:col-span-2 lg:row-span-2 items-center gap-4 mb-4">
                <span class="text-slate-400 text-sm">{formatDate(date)}</span>
            </div>
            <div class="lg:col-span-10 relative overflow-hidden border border-blue-500 rounded-xl bg-slate-800/50">
                <div class="aspect-[16/10] overflow-hidden">
                <img 
                    src={image} 
                    alt={title}
                    class="w-full h-full object-cover  transform group-hover:scale-105 transition-transform duration-500"
                />
                </div>
            </div>
            
            <div class="lg:col-span-10 flex flex-col justify-center">
                <div class="flex lg:hidden items-center gap-4 mb-4">
                    <span class="px-3 py-2 rounded-full border bg-white/5 border-blue-500 text-slate-300 text-xs font-medium">
                        {category}
                    </span>
                    <span class="text-slate-500 text-xs">——</span>
                    <span class="text-white text-xs">{formatDate(date)}</span>
                </div>
                
                <div class="flex flex-row justify-between items-start">
                    <h2 class="w-full lg:w-2/3 2xl:w-1/2 text-2xl lg:text-3xl font-bold text-white mb-4 leading-tight group-hover:text-cyan-400 transition-colors">
                        {title}
                    </h2>
                    <span class="hidden lg:block px-3 py-2 rounded-full border bg-white/5 border-blue-500 text-slate-300 text-xs font-medium items-center">
                        {category}
                    </span>
                </div>
                
                <p class="text-white text-base leading-relaxed mb-6 line-clamp-3">
                    {excerpt}
                </p>
                
                <div class="flex items-center justify-between">
                <a 
                    href={href}
                    class="inline-flex items-center gap-2 text-blue-400 hover:text-blue-300 font-medium transition-colors"
                >
                    Read more
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                    </svg>
                </a>
                </div>
            </div>
        </div>
    </article>
)}

{variant === 'grid' && (
    //   <!-- Mode 2: Grid (3 data terbaru) - Gambar 2 -->
    <article class="group flex flex-col">
        <div class="relative overflow-hidden border border-blue-500  rounded-xl bg-slate-800/50 mb-4">
            <div class="aspect-[16/10] overflow-hidden">
                <img 
                src={image} 
                alt={title}
                class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-500"
                />
            </div>
        </div>
        
        <div class="flex items-center gap-3 mb-3">
            <span class="px-3 py-2 rounded-full border bg-white/5 border-blue-500 text-slate-300 text-xs font-medium">
                {category}
            </span>
            <span class="text-slate-500 text-xs">——</span>
            <span class="text-white text-xs">{formatDate(date)}</span>
        </div>
        
        <h3 class="text-lg font-bold text-white mb-2 leading-tight group-hover:text-cyan-400 transition-colors line-clamp-2">
            {title}
        </h3>
        
        <p class="text-slate-400 text-sm leading-relaxed line-clamp-2">
            {excerpt}
        </p>
    </article>
)}

{variant === 'compact' && (
    //   <!-- Mode 1: Compact (2 per baris dengan kategori) - Gambar 3 -->
    <article class="group">
        <div class="relative overflow-hidden border border-blue-500  rounded-xl bg-slate-800/50 mb-4">
            <div class="aspect-[16/9] overflow-hidden">
                <img 
                    src={image} 
                    alt={title}
                    class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-500"
                />
            </div>
        </div>

        <div class="flex items-center gap-3 mb-3">
            <span class="px-3 py-2 rounded-full border bg-white/5 border-blue-500 text-slate-300 text-xs font-medium">
                {category}
            </span>
            <span class="text-slate-500 text-xs">—</span>
            <span class="text-white text-xs">{formatDate(date)}</span>
        </div>
        
        <h3 class="text-lg font-semibold text-white mb-2 leading-snug group-hover:text-cyan-400 transition-colors">
            {title}
        </h3>
        
        <p class="text-slate-400 text-sm leading-relaxed line-clamp-2">
            {excerpt}
        </p>
    </article>
)}

{variant === 'category-list' && (
//   <!-- Mode: Category List (tanpa gambar, hanya text) -->
  <article class="group">
    <div class="flex items-center gap-3 mb-4">
      <span class="px-3 py-2 rounded-full border bg-white/5 border-blue-500 text-slate-300 text-xs font-medium">
        {category}
      </span>
      <span class="text-slate-500 text-xs">—</span>
      <span class="text-white text-xs">{formatDate(date)}</span>
    </div>

    <h3 class="text-lg font-semibold text-white mb-3 leading-snug group-hover:text-cyan-400 transition-colors">
      <a href={href} class="hover:underline decoration-2 underline-offset-4 decoration-cyan-400/50">
        {title}
      </a>
    </h3>

    <p class="text-slate-400 text-sm leading-relaxed line-clamp-2">
      {excerpt}
    </p>
  </article>
)}