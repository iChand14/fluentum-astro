---
import Navbar from "@components/Navbar.astro";
import Footer from "@components/Footer.astro";
import "../themes/styles/global.css";

const { title = "Portal" } = Astro.props;
---
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <title>{title}</title>
    </head>
    <body class="relative bg-slate-950 text-white font-sans overflow-x-hidden">
        <Navbar />
        <slot />
        <Footer />
    </body>
</html>